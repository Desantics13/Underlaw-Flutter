# Copia este archivo como ".env" (misma carpeta) y llena tus datos.
# .env NO se sube a GitHub.

# MySQL local (Workbench). Recomendado: el usuario creado con sql/00_usuario.sql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=underlaw_mineria
DB_USER=underlaw_ml
DB_PASSWORD=

# De dónde entrenar: mysql | csv | auto (auto = MySQL si conecta; si no, los CSV de data/export)
FUENTE_DATOS=auto

# Servicio de predicción: orígenes permitidos (CORS), separados por coma
CORS_ORIGENES=http://localhost:3000
